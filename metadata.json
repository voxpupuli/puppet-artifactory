{
  "name": "puppet-artifactory",
  "version": "1.0.1-rc0",
  "author": "Vox Pupuli",
  "summary": "Puppet Artifactory module",
  "license": "Apache-2.0",
  "source": "https://github.com/voxpupuli/puppet-artifactory",
  "project_page": "https://github.com/voxpupuli/puppet-artifactory",
  "issues_url": "https://github.com/voxpupuli/puppet-artifactory/issues",
  "dependencies": [
    {
      "name": "puppet/extlib",
      "version_requirement": ">= 6.0.0 < 9.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/apt",
      "version_requirement": ">= 9.0.0 < 12.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "11",
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04",
        "26.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.19.0 < 10.0.0"
    }
  ]
}
